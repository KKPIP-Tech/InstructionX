# 项目运行时产物（本机生成的缓存、日志与临时数据，不入库）
.config/
temp/
.mcp_sdk_temp/
logs/

# 忽略 data 目录（保留 .gitkeep 以便在需要时可以恢复跟踪）
data/*
!.gitkeep

# 忽略 config 目录（保留 .gitkeep 以便在需要时可以恢复跟踪）
config/*
!.gitkeep


# 官方插件安装目录(保留 __init__.py 的跟踪状态,不跟踪安装进来的插件内容,
# 含插件仓库根的 IXRepo.json/README.md 等顶层文件)
plugin/*
custom_plugin/*

# 忽略 ShowDoc 文档目录
ShowDoc/

