/* ═════════════════════════════════════════════════════════════════════════════
 * 按钮样式 (QPushButton)
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 普通按钮 */
QPushButton {
    background-color: {controlFill};
    border: 1px solid {borderLight};
    border-radius: {radius};
    padding: 4px 12px;
    color: {buttonText};
    min-width: 60px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: {controlFillHover};
    border-color: {border};
}

QPushButton:pressed {
    background-color: {controlFillPressed};
}

QPushButton:disabled {
    background-color: {controlFillDisabled};
    color: {textDisabled};
    border-color: {borderLight};
}

QPushButton:focus {
    border: 2px solid {accent};
    padding: 4px 11px;
}

QPushButton:flat {
    background-color: transparent;
    border: none;
}

QPushButton:flat:hover {
    background-color: {controlFillHover};
}

QPushButton:flat:pressed {
    background-color: {controlFillPressed};
}

/* 主要按钮 */
QPushButton[class="primary"], QPushButton[class="accent"] {
    background-color: {accent};
    border: 1px solid {accent};
    color: {highlightedText};
}

QPushButton[class="primary"]:hover, QPushButton[class="accent"]:hover {
    background-color: {accentLight};
    border-color: {accentLight};
}

QPushButton[class="primary"]:pressed, QPushButton[class="accent"]:pressed {
    background-color: {accentDark};
    border-color: {accentDark};
}

QPushButton[class="primary"]:disabled, QPushButton[class="accent"]:disabled {
    background-color: {controlFillDisabled};
    border-color: {borderLight};
    color: {textDisabled};
}

/* 危险按钮 */
QPushButton[class="danger"] {
    background-color: #D13438;
    border: 1px solid #D13438;
    color: white;
}

QPushButton[class="danger"]:hover {
    background-color: #E74856;
    border-color: #E74856;
}

QPushButton[class="danger"]:pressed {
    background-color: #A80000;
    border-color: #A80000;
}

/* 成功按钮 */
QPushButton[class="success"] {
    background-color: #107C10;
    border: 1px solid #107C10;
    color: white;
}

QPushButton[class="success"]:hover {
    background-color: #16C60C;
    border-color: #16C60C;
}

QPushButton[class="success"]:pressed {
    background-color: #0B6A0B;
    border-color: #0B6A0B;
}

/* 轮廓按钮 */
QPushButton[class="outline"] {
    background-color: transparent;
    border: 1px solid {border};
    color: {buttonText};
}

QPushButton[class="outline"]:hover {
    background-color: {controlFillHover};
    border-color: {accent};
}

/* 柔和按钮 */
QPushButton[class="subtle"] {
    background-color: transparent;
    border: none;
    color: {buttonText};
}

QPushButton[class="subtle"]:hover {
    background-color: {controlFillHover};
}

QPushButton[class="subtle"]:pressed {
    background-color: {controlFillPressed};
}

/* 保存按钮（强调色）- 启用状态：蓝色背景，白色文字 */
QPushButton[class="accentSave"] {
    background-color: {accent};
    border: 1px solid {accent};
    border-radius: {radius};
    color: {highlightedText};
    padding: 4px 10px;
}
QPushButton[class="accentSave"]:hover { 
    background-color: {accentLight}; 
    border-color: {accentLight}; 
    color: {highlightedText};
}
QPushButton[class="accentSave"]:pressed { 
    background-color: {accentDark}; 
    border-color: {accentDark}; 
    color: {highlightedText};
}
/* 保存按钮 - 禁用状态：灰色背景，灰色文字（可见但不可点击） */
QPushButton[class="accentSave"]:disabled { 
    background-color: {button}; 
    color: {textDisabled}; 
    border-color: {borderLight};
}

/* 警告/刷新按钮 */
QPushButton[class="warning"] {
    background-color: #FF9800;
    border: 1px solid #FF9800;
    border-radius: {radius};
    color: white;
    padding: 4px 10px;
}
QPushButton[class="warning"]:hover { background-color: #F57C00; border-color: #F57C00; }
