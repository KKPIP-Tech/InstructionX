/* ═════════════════════════════════════════════════════════════════════════════
 * 复选框 (QCheckBox)
 * ═════════════════════════════════════════════════════════════════════════════ */

QCheckBox {
    color: {windowText};
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {border};
    border-radius: 2px;
    background-color: {controlFill};
}

QCheckBox::indicator:hover {
    border-color: {accent};
    background-color: {controlFillHover};
}

QCheckBox::indicator:checked {
    background-color: {accent};
    border-color: {accent};
    image: none;
}

QCheckBox::indicator:checked:hover {
    background-color: {accentLight};
    border-color: {accentLight};
    image: none;
}

QCheckBox::indicator:indeterminate {
    background-color: {accent};
    border-color: {accent};
    image: none;
}

QCheckBox:disabled {
    color: {textDisabled};
}

QCheckBox::indicator:disabled {
    background-color: {controlFillDisabled};
    border-color: {borderLight};
}
