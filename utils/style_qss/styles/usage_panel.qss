/* ═════════════════════════════════════════════════════════════════════════════
 * 用量查询面板专用样式 (Usage Panel)
 * 设计风格移植自用量面板 Demo：低饱和、扁平、1px 细边框、圆角 ≤ 6px，
 * 全部使用 StyleQSS 变量，随全局亮/暗主题自动切换。
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 面板顶层滚动区：透明背景，透出对话框底色 */
#usageScrollArea {
    background: transparent;
    border: none;
}

/* 顶部标题 */
#usageTitle {
    color: {textPrimary};
    font-size: 18px;
    font-weight: 700;
}

#usageSubtitle {
    color: {textSecondary};
    font-size: 12px;
}

/* 子面板标题与状态文本 */
#usagePanelTitle {
    color: {textPrimary};
    font-size: 14px;
    font-weight: 600;
}

#usageStatusText {
    color: {textSecondary};
    font-size: 12px;
}

/* KPI 卡片 */
#kpiCard {
    background-color: {cardBackground};
    border: 1px solid {borderLight};
    border-radius: 6px;
}

#kpiTitle {
    color: {textSecondary};
    font-size: 12px;
}

#kpiValue {
    color: {textPrimary};
    font-size: 22px;
    font-weight: 700;
}

#kpiDelta {
    color: {textSecondary};
    font-size: 11px;
}

#kpiDelta[trend="up"] {
    color: {progressSuccess};
}

#kpiDelta[trend="down"] {
    color: {progressError};
}

#kpiDelta[trend="flat"] {
    color: {textSecondary};
}

/* 子面板容器（用量趋势 / 使用历史） */
#usageSubPanel {
    background-color: {cardBackground};
    border: 1px solid {borderLight};
    border-radius: 6px;
}

/* 筛选工具行 */
#usageFilterLabel {
    color: {textSecondary};
    font-size: 12px;
}

#usageFilterCombo {
    min-width: 100px;
    max-width: 160px;
}

#usageConvInput {
    min-width: 140px;
    max-width: 200px;
}

#usageDateEdit {
    min-width: 110px;
}

#usageRefreshBtn {
    min-width: 72px;
}

/* 明细表格 */
#usageTable {
    background-color: {cardBackground};
    color: {textPrimary};
    border: none;
    alternate-background-color: {alternateBase};
    selection-background-color: {controlFillSelected};
    selection-color: {textPrimary};
    outline: none;
}

#usageTable::item {
    border: none;
    padding-left: 4px;
    padding-right: 4px;
}

#usageTable QHeaderView::section {
    background-color: {cardBackground};
    color: {textSecondary};
    border: none;
    border-bottom: 1px solid {borderLight};
    padding: 6px 4px;
    font-size: 12px;
}

/* 分页控件 */
#usagePageLabel {
    color: {textSecondary};
    font-size: 12px;
    min-width: 180px;
}

#usagePageBtn {
    min-width: 72px;
}
