/* ═════════════════════════════════════════════════════════════════════════════
 * 基础设置
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 全局重置 */
* {
    outline: none;
}

/* 基础窗口 */
QWidget {
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 12px;
}

QMainWindow, QDialog, QMessageBox {
    background-color: {window};
}


/* 通用框架 */
QFrame, QStackedWidget, QScrollArea {
    background-color: {window};
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    border: 1px solid {borderLight};
    border-radius: {radius};
}

/* 键盘焦点指示：Qt Style Sheets 不支持 :focus-visible（会被静默忽略），
   统一使用 :focus 伪状态，为输入类控件提供可见焦点边框（配合上方 outline 重置） */
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus,
QPushButton:focus, QToolButton:focus, QCheckBox:focus, QRadioButton:focus,
QSlider:focus, QTabBar:focus,
QListWidget:focus, QTreeWidget:focus, QTableWidget:focus {
    border: 2px solid {accent};
    border-radius: {radius};
}

/* 拖拽区域 */
QWidget[Drag="true"] {
    background-color: {controlFillHover};
}

/* 载入指示器 */
QLoadingIndicator {
    color: {accent};
}
