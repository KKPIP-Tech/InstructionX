/* ═════════════════════════════════════════════════════════════════════════════
 * 分组框 (QGroupBox)
 * ═════════════════════════════════════════════════════════════════════════════ */

QGroupBox {
    border: 1px solid {borderLight};
    border-radius: {radius};
    margin-top: 10px;
    padding-top: 12px;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    color: {windowText};
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: {windowText};
    font-size: 11px;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {border};
    border-radius: 2px;
    background-color: {controlFill};
}

QGroupBox::indicator:hover {
    border-color: {accent};
    background-color: {controlFillHover};
}

QGroupBox::indicator:checked {
    background-color: {accent};
    border-color: {accent};
    image: none;
}

QGroupBox::indicator:unchecked {
    background-color: {controlFill};
    border-color: {border};
}
