/* ═════════════════════════════════════════════════════════════════════════════
 * 工具栏 (QToolBar, QToolButton)
 * 风格来源：DemoUIDesign/ix-ce-desktop — 圆角边框按钮
 * ═════════════════════════════════════════════════════════════════════════════ */

QToolBar {
    background: {menuBarBg};
    border: 1px solid {borderLight};
    border-radius: 6px;
    padding: 4px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background: {borderLight};
    margin: 4px;
}

/* 仅作用于 QToolBar 内部的 QToolButton，避免影响 SkillButton 等其他 QToolButton */
QToolBar QToolButton {
    background: {menuPopupBg};
    color: {textSecondary};
    border: 1px solid {borderLight};
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
}

QToolBar QToolButton:hover {
    background: {window};
    color: {windowText};
    border: 1px solid {accent};
}

QToolBar QToolButton:pressed {
    background: {controlFillPressed};
    color: {windowText};
    border: 1px solid {accentDark};
}

QToolBar QToolButton:disabled {
    background: transparent;
    color: {textDisabled};
    border: 1px solid {borderLight};
    opacity: 0.5;
}

QToolButton[popupMode="1"]::menu-button {
    border: none;
    width: 16px;
}

QToolButton[popupMode="2"]::menu-button {
    border: none;
    width: 16px;
}
