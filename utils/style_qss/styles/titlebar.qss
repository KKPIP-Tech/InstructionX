/* ═════════════════════════════════════════════════════════════════════════════
 * 自定义标题栏 (CustomTitleBar) - 高度 40px
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 标题栏容器 */
CustomTitleBar {
    background-color: transparent;
}

/* Logo - 加载图片 */
QLabel#titleLogo {
    background-color: transparent;
    border-radius: 3px;
}

/* 软件名称 */
QLabel#titleText {
    color: {textPrimary};
    background: transparent;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding-right: 10px;
}

/* 标题栏菜单栏 */
QMenuBar#titleMenuBar {
    background: transparent;
    color: {textPrimary};
    border: none;
    padding: 0px;
    font-size: 14px;
}

QMenuBar#titleMenuBar::item {
    background: transparent;
    padding: 8px 14px;
    border-radius: 4px;
}

QMenuBar#titleMenuBar::item:selected {
    background-color: {controlFillHover};
}

/* 窗口控制按钮 - Windows 原生风格 */
QPushButton#btnMinimize,
QPushButton#btnMaximize,
QPushButton#btnClose {
    background-color: transparent;
    color: {textPrimary};
    border: none;
    border-radius: 0px;
    font-size: 12px;
    font-family: "Segoe UI Symbol", "Segoe UI", sans-serif;
    padding: 0px;
    margin: 0px;
    min-width: 40px;
    max-width: 40px;
    width: 40px;
    min-height: 40px;
    max-height: 40px;
    height: 40px;
}

/* 最小化/最大化按钮悬停效果 - 半透明背景 */
QPushButton#btnMinimize:hover,
QPushButton#btnMaximize:hover {
    background-color: {controlFillHover};
}

/* 关闭按钮悬停效果 - Windows 红色 */
QPushButton#btnClose:hover {
    background-color: #E81123;
    color: white;
}

/* 窗口控制按钮容器 */
QWidget#windowControls {
    background: transparent;
}
