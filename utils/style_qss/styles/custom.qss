/* ═════════════════════════════════════════════════════════════════════════════
 * 自定义样式类
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 此文件用于添加自定义样式类或覆盖默认样式 */

/* ═════════════════════════════════════════════════════════════════════════════
 * 技能面板 (SkillsPanel)
 * ═════════════════════════════════════════════════════════════════════════════ */

/* SkillsPanel 容器 - 使用 skillPanel 专用色 */
SkillsPanel {
    background-color: {skillPanel};
    border-bottom: 1px solid {borderLight};
}

/* SkillsPanel Tab 样式 - Office 风格 */
SkillsPanel QTabWidget::pane {
    border: none;
    background: {skillPanel};
}
SkillsPanel QTabBar::tab {
    background: {skillPanelTab};
    color: {windowText};
    padding: 2px 10px;
    margin-right: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-height: 16px;
    font-size: 11px;
    border: none;
}
SkillsPanel QTabBar::tab:selected {
    background: {skillPanel};
    border-bottom: 2px solid {accent};
}
SkillsPanel QTabBar::tab:hover:!selected {
    background: {controlFillHover};
}

/* SkillsPanel 滚动区域 */
SkillsPanel QScrollArea {
    border: none;
    background: {skillPanel};
}
SkillsPanel QScrollArea:hover QScrollBar::handle:horizontal {
    background: rgba(160, 160, 160, 0.8);
}
SkillsPanel QScrollArea:hover QScrollBar::handle:horizontal:hover {
    background: rgba(128, 128, 128, 1);
}
SkillsPanel QScrollBar::handle:horizontal:active {
    background: rgba(128, 128, 128, 1);
}

/* SkillsPanel 容器 widget */
SkillsPanel QWidget#skillsContainer {
    background-color: {skillPanel};
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 技能按钮 (SkillButton) - MS Office 风格
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 非激活状态 */
SkillButton {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px;
    background-color: transparent;
    color: {windowText};
    text-align: top;
    font-size: 10px;
}
SkillButton:hover {
    background-color: {controlFillHover};
    border: 1px solid {borderLight};
}
SkillButton:pressed {
    background-color: {controlFillPressed};
    border: 1px solid {border};
}

/* 激活状态 */
SkillButton[active="true"] {
    border: 2px solid {accent};
    border-radius: 6px;
    padding: 2px;
    background-color: {controlFillSelected};
    color: {accent};
    text-align: top;
    font-weight: 500;
    font-size: 10px;
}
