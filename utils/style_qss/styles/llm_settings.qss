/* ═════════════════════════════════════════════════════════════════════════════
 * LLM 设置中心样式
 * ═════════════════════════════════════════════════════════════════════════════ */

/* ═════════════════════════════════════════════════════════════════════════════
 * 两栏布局容器
 * ═════════════════════════════════════════════════════════════════════════════ */

#llmSettingsDialog {
    background-color: {window};
}

/* 左侧面板 */
#leftPanel {
    background-color: {window};
    border-right: 1px solid {borderLight};
    min-width: 240px;
    max-width: 280px;
}

/* 右侧详情面板 */
#detailScrollArea {
    background-color: {window};
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 设置分类项 (SettingsCategoryItem)
 * ═════════════════════════════════════════════════════════════════════════════ */

#settingsCategoryItem {
    background-color: transparent;
    border-radius: 8px;
}

#settingsCategoryItem:hover {
    background-color: {controlFillHover};
}

QLabel#categoryIcon,
QLabel#categoryText {
    color: {textPrimary};
    font-size: 13px;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * Provider 列表项 (ProviderListItem)
 * ═════════════════════════════════════════════════════════════════════════════ */

#providerListItem {
    background-color: transparent;
    border-radius: 8px;
    margin: 2px 8px;
}

#providerListItem:hover {
    background-color: {controlFillHover};
}

#providerListItem[selected="true"] {
    background-color: {controlFillSelected};
}

QLabel#providerNameLabel {
    color: {textPrimary};
    font-size: 13px;
}

QLabel#providerStatusLabel {
    font-size: 10px;
    font-weight: bold;
    border-radius: 10px;
    padding: 2px 8px;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 模型详情列表项 (ModelDetailItem)
 * ═════════════════════════════════════════════════════════════════════════════ */

#modelDetailItem {
    background-color: transparent;
    border-radius: 8px;
    margin: 2px 0;
}

#modelDetailItem:hover {
    background-color: {controlFillHover};
}

QLabel#modelIcon {
    background-color: {accent};
    border-radius: 8px;
    color: white;
    font-size: 14px;
    font-weight: bold;
}

QLabel#modelName {
    color: {textPrimary};
    font-size: 14px;
    font-weight: 500;
}

QLabel#modelContext {
    color: {textSecondary};
    font-size: 11px;
}

/* 模型类别标签 - Chat/Embedding */
QLabel#modelTag[text="Chat"] {
    color: #2196F3;
    background-color: #E3F2FD;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: bold;
}

QLabel#modelTag[text="Embedding"] {
    color: #2196F3;
    background-color: #E3F2FD;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: bold;
}

/* 能力标签 */
QLabel#modelTag[text="Vision"] {
    color: #9C27B0;
    background-color: #F3E5F5;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: bold;
}

QLabel#modelTag[text="Thinking"] {
    color: #FF9800;
    background-color: #FFF3E0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: bold;
}

QLabel#modelTag[text="Tools"] {
    color: #009688;
    background-color: #E0F2F1;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: bold;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 搜索框
 * ═════════════════════════════════════════════════════════════════════════════ */

#providerSearchBox {
    background-color: {controlFill};
    border: 1px solid {borderLight};
    border-radius: 20px;
    padding: 8px 16px;
    color: {textPrimary};
    font-size: 13px;
}

#providerSearchBox:focus {
    border-color: {accent};
    background-color: {base};
}

#providerSearchBox::placeholder {
    color: {textSecondary};
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 详情区头部
 * ═════════════════════════════════════════════════════════════════════════════ */

#detailHeader {
    background-color: transparent;
    padding: 24px;
}

#providerLogoLabel {
    background-color: {accent};
    border-radius: 12px;
    color: white;
    font-size: 24px;
    font-weight: bold;
}

#providerTitleLabel {
    color: {textPrimary};
    font-size: 20px;
    font-weight: bold;
}

#providerSubtitleLabel {
    color: {textSecondary};
    font-size: 13px;
}

/* 开关按钮 */
#providerToggleSwitch {
    min-width: 44px;
    max-width: 44px;
    min-height: 24px;
    max-height: 24px;
    border-radius: 12px;
    background-color: {accent};
}

#providerToggleSwitch::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: white;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 操作按钮 (ActionButton)
 * ═════════════════════════════════════════════════════════════════════════════ */

#actionButton {
    background-color: {controlFill};
    border: 1px solid {borderLight};
    border-radius: 16px;
    color: {textPrimary};
    font-size: 13px;
    padding: 6px 16px;
    min-height: 32px;
}

#actionButton:hover {
    background-color: {controlFillHover};
    border-color: {accent};
}

#actionButton:pressed {
    background-color: {controlFillPressed};
}

/* 主要操作按钮 */
#actionButton[class="primary"] {
    background-color: {accent};
    border-color: {accent};
    color: white;
}

#actionButton[class="primary"]:hover {
    background-color: {accentLight};
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 可折叠分组 (CollapsibleGroup)
 * ═════════════════════════════════════════════════════════════════════════════ */

#collapsibleHeader {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 12px;
    border-radius: 8px;
}

#collapsibleHeader:hover {
    background-color: {controlFillHover};
}

#collapsibleArrow {
    color: {textSecondary};
    font-size: 12px;
}

#collapsibleTitle {
    color: {textPrimary};
    font-size: 14px;
    font-weight: bold;
}

#collapsibleCount {
    background-color: {controlFill};
    color: {textSecondary};
    border-radius: 9px;
    font-size: 11px;
    font-weight: bold;
}

#collapsibleContent {
    background-color: transparent;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 模型列表项 (ModelListItem)
 * ═════════════════════════════════════════════════════════════════════════════ */

#modelListItem {
    background-color: transparent;
    border-radius: 6px;
    margin: 2px 0;
}

#modelListItem:hover {
    background-color: {controlFillHover};
}

QLabel#modelNameLabel {
    color: {textPrimary};
    font-size: 13px;
}

QToolButton#modelActionBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: {textSecondary};
    font-size: 14px;
}

QToolButton#modelActionBtn:hover {
    background-color: {controlFillHover};
    color: {textPrimary};
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 带图标的输入框 (IconLineEdit)
 * ═════════════════════════════════════════════════════════════════════════════ */

QLineEdit#iconLineEdit {
    background-color: {controlFill};
    border: 1px solid {borderLight};
    border-radius: 8px;
    padding: 10px 12px;
    color: {textPrimary};
    font-size: 13px;
    min-height: 20px;
}

QLineEdit#iconLineEdit:focus {
    border-color: {accent};
    background-color: {base};
}

QLineEdit#iconLineEdit::placeholder {
    color: {textSecondary};
}

QToolButton#lineEditIconBtn {
    background-color: transparent;
    border: none;
    color: {textSecondary};
    font-size: 14px;
}

QToolButton#lineEditIconBtn:hover {
    color: {accent};
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 表单标签
 * ═════════════════════════════════════════════════════════════════════════════ */

QLabel#formLabel {
    color: {textSecondary};
    font-size: 13px;
    min-width: 80px;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 添加按钮
 * ═════════════════════════════════════════════════════════════════════════════ */

#addProviderBtn {
    background-color: {controlFill};
    border: 1px dashed {border};
    border-radius: 8px;
    color: {accent};
    font-size: 13px;
    padding: 12px;
    margin: 8px;
}

#addProviderBtn:hover {
    background-color: {controlFillHover};
    border-style: solid;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 链接文字
 * ═════════════════════════════════════════════════════════════════════════════ */

#linkLabel {
    color: {accent};
    font-size: 13px;
    text-decoration: none;
}

#linkLabel:hover {
    text-decoration: underline;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 工具栏
 * ═════════════════════════════════════════════════════════════════════════════ */

#toolbar {
    background-color: transparent;
    padding: 8px 0;
}

#toolbar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: {textSecondary};
    padding: 4px 8px;
}

#toolbar QToolButton:hover {
    background-color: {controlFillHover};
    color: {textPrimary};
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 模型分组标签
 * ═════════════════════════════════════════════════════════════════════════════ */

#modelGroupLabel {
    background-color: {controlFill};
    color: {textSecondary};
    font-size: 12px;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 12px;
    margin: 4px 0;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 分隔线
 * ═════════════════════════════════════════════════════════════════════════════ */

#sectionDivider {
    background-color: {borderLight};
    max-height: 1px;
    margin: 16px 0;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 滚动区域
 * ═════════════════════════════════════════════════════════════════════════════ */

QScrollArea#detailScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea#detailScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 滚动条样式 */
QScrollArea#detailScrollArea QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    border-radius: 4px;
}

QScrollArea#detailScrollArea QScrollBar:vertical:hover {
    background-color: {controlFill};
}

QScrollArea#detailScrollArea QScrollBar::handle:vertical {
    background-color: {border};
    border-radius: 4px;
    min-height: 30px;
}

QScrollArea#detailScrollArea QScrollBar::handle:vertical:hover {
    background-color: {accent};
}

QScrollArea#detailScrollArea QScrollBar::add-line:vertical,
QScrollArea#detailScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 底部按钮栏
 * ═════════════════════════════════════════════════════════════════════════════ */

#bottomBar {
    background-color: {window};
    border-top: 1px solid {borderLight};
    padding: 12px 24px;
}

#bottomBar QPushButton {
    min-width: 80px;
    min-height: 32px;
    border-radius: 6px;
    font-size: 13px;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 用量统计标签
 * ═════════════════════════════════════════════════════════════════════════════ */

#usageLabel {
    color: {textSecondary};
    font-size: 12px;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * Provider 列表滚动区域
 * ═════════════════════════════════════════════════════════════════════════════ */

QListWidget#providerListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

QListWidget#providerListWidget::item {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 2px 8px;
}

QListWidget#providerListWidget::item:selected {
    background-color: transparent;
}

QListWidget#providerListWidget::item:hover {
    background-color: transparent;
}

QListWidget#providerListWidget:focus {
    outline: none;
}