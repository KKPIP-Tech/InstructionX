/* ═════════════════════════════════════════════════════════════════════════════
 * 菜单 (QMenuBar, QMenu)
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 菜单栏 */
QMenuBar {
    background-color: {window};
    border-bottom: 1px solid {borderLight};
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    color: {windowText};
}

QMenuBar::item:selected {
    background-color: {controlFillHover};
}

QMenuBar::item:pressed {
    background-color: {controlFillPressed};
}

QMenuBar::item:disabled {
    color: {textDisabled};
}

/* 菜单 */
QMenu {
    background-color: {window};
    border: 1px solid {borderLight};
    border-radius: {radius};
    padding: 4px;
    margin: 0px;
}

QMenu::item {
    padding: 4px 24px;
    padding-left: 32px;
    color: {windowText};
    border-radius: 4px;
    min-width: 120px;
}

QMenu::item:selected {
    background-color: {controlFillHover};
    color: {windowText};
}

QMenu::item:disabled {
    color: {textDisabled};
}

QMenu::separator {
    height: 1px;
    background-color: {borderLight};
    margin: 4px 12px;
}

QMenu::icon {
    margin-left: 8px;
    width: 16px;
    height: 16px;
}

QMenu::indicator {
    width: 18px;
    height: 18px;
    margin-left: 6px;
    border-radius: 3px;
    border: 1px solid {border};
}

QMenu::indicator:checked {
    background-color: {accent};
    border-color: {accent};
    image: none;
}

QMenu::indicator:non-exclusive:checked {
    background-color: {accent};
    border-color: {accent};
    image: none;
    border-radius: 9px;
}

QMenu::right-arrow {
    image: none;
    border-left: 5px solid {buttonText};
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
}
