/* ═════════════════════════════════════════════════════════════════════════════
 * 滑块 (QSlider) - 修复截断问题版本
 * ═════════════════════════════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────────────────────────────────────
 * 水平滑块
 * ───────────────────────────────────────────────────────────────────────────── */

QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: {borderLight};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    /* 负 margin 让 handle 超出 groove，需要容器有足够空间 */
    margin: -6px 0;
    background: {accent};
    border-radius: 9px;
    border: 2px solid white;
}

QSlider::handle:horizontal:hover {
    background: {accentLight};
}

QSlider::handle:horizontal:pressed {
    background: {accentDark};
}

QSlider::handle:horizontal:disabled {
    background: {borderLight};
    border: 2px solid {borderLight};
}

QSlider::sub-page:horizontal {
    background: {accent};
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: {borderLight};
    border-radius: 3px;
}

/* 
 * 【修复关键】使用更具体的选择器提高优先级
 * 容器高度 = handle 高度 (18px) + 上下 margin (6px × 2) + 安全边距 (2px) = 32px
 */
QSlider[orientation="horizontal"] {
    min-height: 32px !important;
    max-height: 32px !important;
}

/* 针对基础控件页面的滑块特别样式 */
QGroupBox > QGridLayout > QSlider[orientation="horizontal"] {
    min-height: 32px !important;
    max-height: 32px !important;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * 垂直滑块
 * ───────────────────────────────────────────────────────────────────────────── */

QSlider::groove:vertical {
    border: none;
    width: 6px;
    background: {borderLight};
    border-radius: 3px;
}

QSlider::handle:vertical {
    width: 18px;
    height: 18px;
    /* 负 margin 让 handle 超出 groove，需要容器有足够空间 */
    margin: 0 -6px;
    background: {accent};
    border-radius: 9px;
    border: 2px solid white;
}

QSlider::handle:vertical:hover {
    background: {accentLight};
}

QSlider::handle:vertical:pressed {
    background: {accentDark};
}

QSlider::handle:vertical:disabled {
    background: {borderLight};
    border: 2px solid {borderLight};
}

QSlider::sub-page:vertical {
    background: {accent};
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: {borderLight};
    border-radius: 3px;
}

/* 
 * 【修复关键】容器宽度 = handle 宽度 (18px) + 左右 margin (6px × 2) + 安全边距 (2px) = 32px
 */
QSlider[orientation="vertical"] {
    min-width: 32px !important;
    max-width: 32px !important;
    min-height: 100px !important;
}

/* 针对基础控件页面的垂直滑块特别样式 */
QGroupBox > QGridLayout > QSlider[orientation="vertical"] {
    min-width: 32px !important;
    max-width: 32px !important;
    min-height: 120px !important;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * 旋钮 (QDial) - 移除无效的子控件选择器
 * ───────────────────────────────────────────────────────────────────────────── */

QDial {
    background-color: {controlFill};
    border: 1px solid {borderLight};
    border-radius: 50px;
    min-width: 60px;
    min-height: 60px;
}

QDial:hover {
    border: 1px solid {accent};
}

QDial:disabled {
    background-color: {borderLight};
    border: 1px solid {borderLight};
}

