/* ═════════════════════════════════════════════════════════════════════════════
 * 自定义样式类
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 此文件用于添加自定义样式类或覆盖默认样式 */

/* ═════════════════════════════════════════════════════════════════════════════
 * 技能面板 (SkillsPanel)
 * ═════════════════════════════════════════════════════════════════════════════ */

/* SkillsPanel 容器 */
SkillsPanel {
    background-color: #F5F5F5;
    border-bottom: 1px solid #D0D0D0;
}

/* SkillsPanel Tab 样式 - Office 风格 */
SkillsPanel QTabWidget::pane {
    border: none;
    background: #F5F5F5;
}
SkillsPanel QTabBar::tab {
    background: #E8E8E8;
    padding: 2px 10px;
    margin-right: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-height: 16px;
    font-size: 11px;
    border: none;
}
SkillsPanel QTabBar::tab:selected {
    background: #F5F5F5;
    border-bottom: 2px solid {accent};
}
SkillsPanel QTabBar::tab:hover:!selected {
    background: #DCDCDC;
}

/* SkillsPanel 滚动区域 */
SkillsPanel QScrollArea {
    border: none;
    background: #F5F5F5;
}
SkillsPanel QScrollArea:hover QScrollBar::handle:horizontal {
    background: rgba(160, 160, 160, 0.8);
}
SkillsPanel QScrollArea:hover QScrollBar::handle:horizontal:hover {
    background: rgba(128, 128, 128, 1);
}
SkillsPanel QScrollBar::handle:horizontal:active {
    background: rgba(128, 128, 128, 1);
}

/* SkillsPanel 容器 widget */
SkillsPanel QWidget#skillsContainer {
    background-color: #F5F5F5;
}

/* ═════════════════════════════════════════════════════════════════════════════
 * 技能按钮 (SkillButton) - MS Office 风格
 * ═════════════════════════════════════════════════════════════════════════════ */

/* 非激活状态 */
SkillButton {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px;
    background-color: transparent;
    color: #1F1F1F;
    text-align: top;
    font-size: 10px;
}
SkillButton:hover {
    background-color: rgba(0, 0, 0, 5);
    border: 1px solid rgba(0, 0, 0, 10);
}
SkillButton:pressed {
    background-color: rgba(0, 0, 0, 10);
    border: 1px solid rgba(0, 0, 0, 20);
}

/* 激活状态 */
SkillButton[active="true"] {
    border: 2px solid {accent};
    border-radius: 6px;
    padding: 2px;
    background-color: rgba(0, 120, 212, 15);
    color: {accentDark};
    text-align: top;
    font-weight: 500;
    font-size: 10px;
}
